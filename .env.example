# Copia este archivo a .env.local y rellena los valores.
# .env.local esta en .gitignore: nunca lo subas.

# Sin estas dos variables la aplicacion funciona igual, solo que no se anota
# la ficha en la lista. Sirve para desarrollar y para que la suite de pruebas
# pase sin tocar Supabase.

# Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings -> API -> service_role
# OJO: esta clave esquiva la seguridad por fila. Solo va en el servidor.
# Si se filtra, cualquiera puede leer y borrar la tabla entera desde Internet:
# rotala en cuanto pase por un commit, un log o una captura.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
